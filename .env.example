# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
# Service role key (Supabase → Settings → API → service_role). SERVER-ONLY, bypasses RLS.
# Required for the task-reminders cron to see every task and email its assignee — without it
# the cron runs but sends nothing. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Discord Notification Configuration
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL_HERE

# Resend (task assignment + due-date reminder emails) — sign up at resend.com, verify a
# sending domain (or use their onboarding@resend.dev test address to start), and create an
# API key under API Keys.
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL="Dr. Interested Portal <portal@yourdomain.org>"

# Shared secret the cron scheduler sends as the x-cron-secret header when calling
# /api/cron/* routes. Set the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Shared secret for the Supabase "tasks INSERT" Database Webhook -> /api/tasks/on-insert,
# which sends the "you've been assigned a task" email instantly for every new task (UI, SQL
# script, or Node script). Configure the webhook in Supabase → Database → Webhooks and add
# an HTTP header  x-webhook-secret: <this value>.
TASK_WEBHOOK_SECRET=YOUR_TASK_WEBHOOK_SECRET_HERE

# Google OAuth connection used to browse AND organize the member portal's Google Drive folder
# (app/api/drive/*). This intentionally connects a REAL Google account (ideally the one that
# already owns the shared Drive folder, so nothing needs re-sharing) rather than a service
# account — service accounts have zero Drive storage quota, so creating/copying/uploading a
# file (which makes the account its owner) fails with "storage quota exceeded" unless the
# folder lives in a paid Google Workspace Shared Drive. See the comment at the top of
# lib/google-drive.ts for the full explanation.
#
# Setup:
#   1. Google Cloud Console → APIs & Services → OAuth consent screen: User type "External",
#      fill in the required fields, add scope https://www.googleapis.com/auth/drive, then
#      click "Publish App" (an unverified-app warning during consent is expected and fine to
#      click through — this is for one internal account, not public users).
#   2. APIs & Services → Credentials → Create Credentials → OAuth client ID → Web application.
#      Add both http://localhost:3000/api/drive/oauth/callback and
#      https://www.drinterested.org/api/drive/oauth/callback as Authorized redirect URIs.
#   3. Copy the Client ID and Client Secret into the two variables below.
#   4. Visit /api/drive/oauth/start, sign in as the Google account that owns the shared Drive
#      folder, and grant access. The callback page shows a refresh token — copy that into
#      GOOGLE_DRIVE_REFRESH_TOKEN below.
#
# Nothing reachable through the portal can delete a Drive file — there is no delete endpoint
# in the code at all, regardless of this account's access level (see lib/google-drive.ts).
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET_HERE
GOOGLE_DRIVE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN_FROM_THE_OAUTH_CALLBACK_PAGE_HERE
