# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Discord Notification Configuration
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL_HERE

# Resend (task assignment + due-date reminder emails) — sign up at resend.com, verify a
# sending domain (or use their onboarding@resend.dev test address to start), and create an
# API key under API Keys.
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL="Dr. Interested Portal <portal@yourdomain.org>"

# Shared secret the cron scheduler sends as the x-cron-secret header when calling
# /api/cron/* routes. Set the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Google service account used to browse the member portal's Google Drive folder
# (app/api/drive/list). Create a project + service account + Drive API access, share the
# target Drive folder with the service account's email (Viewer), then base64-encode the
# whole downloaded JSON key file and paste the result here — see scripts/ or ask Claude for
# the exact steps. Example (PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON_HERE
